# Copia este archivo a ".env" y completa tu API key.
# NUNCA subas el archivo ".env" real a git (ya está en .gitignore).

GEMINI_API_KEY=tu_api_key_aqui

# Modelo de chat y de embeddings (para RAG)
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Host/puerto donde corre el servicio del motor cognitivo
HOST=127.0.0.1
PORT=8765

# TTL del caché de respuestas, en segundos
CACHE_TTL_SECONDS=1800
